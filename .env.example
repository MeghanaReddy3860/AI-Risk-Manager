# ===========================================
# AI Risk Manager — Environment Variables
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.
# ===========================================

# --- Application ---
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# --- Database ---
# SQLite path (relative to backend/)
DATABASE_URL=sqlite:///./data/risk_manager.db

# --- AI / LLM (Phase 8+) ---
# Uncomment and set when ready for LLM integration
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o

# --- Risk Scoring (configurable thresholds) ---
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=60
RISK_HIGH_MAX=80
# Scores above RISK_HIGH_MAX are CRITICAL

# --- Cost Assumptions (configurable) ---
# Cost per false-positive review (INR)
COST_PER_FALSE_POSITIVE=500
# Average cost per missed fraud spike (INR)
COST_PER_FALSE_NEGATIVE=15000

# --- Detection Thresholds ---
BASELINE_WINDOW_SIZE=7
BASELINE_ZSCORE_THRESHOLD=2.0
ISOLATION_FOREST_CONTAMINATION=0.1

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
